# ---------------------------------------------------------------------------
# haccpFlow - environment template
#
# Copy to `.env` and fill in real values:
#   cp .env.example .env
#
# Never commit `.env` or real credentials. Generate secrets with:
#   openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
TZ=UTC
ENVIRONMENT=development
LOG_LEVEL=info

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_USER=haccp
POSTGRES_DB=haccp
# Required. Empty or missing values make `docker compose` fail on purpose.
POSTGRES_PASSWORD=
# Host port for local tooling (bound to 127.0.0.1 only).
POSTGRES_PORT=5432

# --- MQTT (Mosquitto) ------------------------------------------------------
# Required. Anonymous connections are refused.
MQTT_USERNAME=haccp
MQTT_PASSWORD=
# Host port for local tooling (bound to 127.0.0.1 only).
MQTT_PORT=1883
# Topic prefix Zigbee2MQTT publishes to; the backend subscribes below it.
MQTT_TOPIC_PREFIX=zigbee2mqtt

# --- Backend (FastAPI) -----------------------------------------------------
BACKEND_PORT=8000
# Required. Signs auth tokens; generate with `openssl rand -hex 32`.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:3000

# --- Frontend (Next.js) ----------------------------------------------------
FRONTEND_PORT=3000
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8000
